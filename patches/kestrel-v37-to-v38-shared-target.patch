+    BWAPI::Unit sharedVisibleEnemyTarget(const BWAPI::Position& home, int localCompletedZealots) {
+        std::vector<BWAPI::Unit> participants;
+        int centroidX = 0;
+        int centroidY = 0;
+        for (auto unit : BWAPI::Broodwar->self()->getUnits()) {
+            if (!ordinarySharedParticipant(unit, home, localCompletedZealots)) continue;
+            participants.push_back(unit);
+            centroidX += unit->getPosition().x;
+            centroidY += unit->getPosition().y;
+        }
+        if (participants.empty()) return nullptr;
+        const BWAPI::Position centroid(centroidX / static_cast<int>(participants.size()),
+                                       centroidY / static_cast<int>(participants.size()));
+        std::vector<BWAPI::Unit> candidates;
+        for (auto enemy : BWAPI::Broodwar->getAllUnits()) {
+            if (!enemy->exists() || !enemy->isVisible() || !enemy->isDetected() || enemy->isFlying()) continue;
+            if (!BWAPI::Broodwar->self()->isEnemy(enemy->getPlayer())) continue;
+            candidates.push_back(enemy);
+        }
+        if (candidates.empty()) return nullptr;
+        std::vector<BWAPI::Unit> localCandidates;
+        for (auto enemy : candidates) {
+            if (enemy->getDistance(home) < 12 * 32) localCandidates.push_back(enemy);
+        }
+        const std::vector<BWAPI::Unit>& ordered = localCandidates.empty() ? candidates : localCandidates;
+        if (knownZerg_ && !zergOffenseReleased_ && localCandidates.empty()) return nullptr;
+        if (sharedTargetPreviousId_ >= 0) {
+            for (auto enemy : ordered) {
+                if (enemy->getID() == sharedTargetPreviousId_) return enemy;
+            }
+        }
+        BWAPI::Unit target = nullptr;
+        int bestDistance = std::numeric_limits<int>::max();
+        int bestId = std::numeric_limits<int>::max();
+        for (auto enemy : ordered) {
+            const int distance = enemy->getDistance(centroid);
+            if (distance < bestDistance || (distance == bestDistance && enemy->getID() < bestId)) {
+                bestDistance = distance;
+                bestId = enemy->getID();
+                target = enemy;
+            }
+        }
+        return target;
+    }
