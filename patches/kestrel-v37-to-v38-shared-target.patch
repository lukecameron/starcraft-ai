+    bool ordinarySharedParticipant(BWAPI::Unit unit, const BWAPI::Position& home, int localCompletedZealots) const {
+        if (!unit || !unit->exists() || !unit->isCompleted()) return false;
+        const BWAPI::UnitType type = unit->getType();
+        if (type != BWAPI::UnitTypes::Protoss_Zealot && type != BWAPI::UnitTypes::Protoss_Dragoon) return false;
+        if (isEmergencyDefender(unit->getID())) return false;
+        if (knownZerg_ && isZergReserve(unit->getID())) return false;
+        if (!knownZerg_ && firstHomeThreatFrame_ >= 0 && type == BWAPI::UnitTypes::Protoss_Zealot && localCompletedZealots < 2) return false;
+        (void)home;
+        return true;
+    }
