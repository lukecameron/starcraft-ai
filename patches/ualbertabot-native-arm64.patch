@@ -18,9 +18,41 @@
 #include "Global.h"
 #include "StrategyManager.h"
 #include "MapTools.h"
+#include <cstdlib>
+#include <fstream>
 
 using namespace UAlbertaBot;
 
+namespace {
+void writePortResult(bool ended, bool winner)
+{
+    int workers = 0, combatUnits = 0, productionBuildings = 0;
+    for (auto unit : BWAPI::Broodwar->self()->getUnits()) {
+        const auto type = unit->getType();
+        workers += type.isWorker();
+        combatUnits += type.canAttack() && !type.isWorker();
+        productionBuildings += type.isBuilding() && type.canProduce();
+    }
+    std::ostringstream record;
+    record << "{\"frame_count\":" << BWAPI::Broodwar->getFrameCount()
+           << ",\"winner\":" << (winner ? "true" : "false")
+           << ",\"ended\":" << (ended ? "true" : "false")
+           << ",\"latency_frames\":" << BWAPI::Broodwar->getLatencyFrames()
+           << ",\"workers\":" << workers
+           << ",\"combat_units\":" << combatUnits
+           << ",\"production_buildings\":" << productionBuildings << "}\n";
+    std::ofstream diagnostic("bwapi-data/write/diagnostic.json", std::ios::trunc);
+    diagnostic << record.str();
+    if (ended) {
+        const char *path = std::getenv("MATCH_RESULT_PATH");
+        if (path && path[0]) {
+            std::ofstream result(path, std::ios::trunc);
+            result << record.str();
+        }
+    }
+}
+}
