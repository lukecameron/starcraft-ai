+    void updateDefenseAssignments() {
+        defenders_.clear();
+        const int army = count(BWAPI::UnitTypes::Protoss_Zealot, true) + count(BWAPI::UnitTypes::Protoss_Dragoon, true);
+        if (army >= 4) return;
 
+        const BWAPI::TilePosition start = BWAPI::Broodwar->self()->getStartLocation();
+        const BWAPI::Position home(start.x * 32 + 64, start.y * 32 + 48);
+        BWAPI::Unit threat = nullptr;
+        int nearest = 12 * 32 + 1;
+        for (auto enemy : BWAPI::Broodwar->getAllUnits()) {
+            if (!enemy->exists() || !enemy->isVisible() || !enemy->isDetected() || enemy->isFlying() ||
+                !BWAPI::Broodwar->self()->isEnemy(enemy->getPlayer())) continue;
+            const int distance = enemy->getDistance(home);
+            if (distance < nearest) { nearest = distance; threat = enemy; }
+        }
+        if (!threat) return;
+
+        std::vector<BWAPI::Unit> probes;
+        for (auto unit : BWAPI::Broodwar->self()->getUnits()) {
+            if (!unit->exists() || !unit->isCompleted() || unit->getType() != BWAPI::UnitTypes::Protoss_Probe ||
+                unit->getID() == builderId_ || unit->getID() == scoutId_ || unit->isConstructing()) continue;
+            probes.push_back(unit);
+        }
+        std::sort(probes.begin(), probes.end(), [threat](BWAPI::Unit a, BWAPI::Unit b) {
+            const int da = a->getDistance(threat);
+            const int db = b->getDistance(threat);
+            return da != db ? da < db : a->getID() < b->getID();
+        });
+        const int defenderCount = std::min(6, std::max(0, static_cast<int>(probes.size()) - 4));
+        for (int i = 0; i < defenderCount; ++i) defenders_.insert(probes[static_cast<size_t>(i)]->getID());
+        if (!defenders_.empty() && defenseTriggerFrame_ < 0) defenseTriggerFrame_ = BWAPI::Broodwar->getFrameCount();
+        maxDefenders_ = std::max(maxDefenders_, static_cast<int>(defenders_.size()));
+    }
