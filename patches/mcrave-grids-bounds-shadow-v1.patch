 using namespace BWAPI;
 using namespace std;
 using namespace McRave;
 
+namespace {
+bool evaluationSeedSet = false;
+unsigned evaluationSeed = 0;
+
+void applyEvaluationSeed()
+{
+#ifndef _WIN32
+    const auto raw = std::getenv("MATCH_BOT_SEED");
+    if (!raw)
+        return;
+    if (!*raw)
+        throw runtime_error("MATCH_BOT_SEED must be a decimal uint32");
+
+    unsigned long long value = 0;
+    for (auto p = raw; *p; ++p) {
+        if (*p < '0' || *p > '9')
+            throw runtime_error("MATCH_BOT_SEED must be a decimal uint32");
+        value = value * 10 + unsigned(*p - '0');
+        if (value > numeric_limits<unsigned>::max())
+            throw runtime_error("MATCH_BOT_SEED exceeds uint32");
+    }
+    evaluationSeed = unsigned(value);
+    evaluationSeedSet = true;
+    std::srand(evaluationSeed);
+#endif
+}
+
+void writeDiagnostics(bool ended, bool winner)
+{
+    int drones = 0, hatcheries = 0, spawningPools = 0, zerglings = 0;
+    for (auto unit : Broodwar->self()->getUnits()) {
+        auto type = unit->getType();
+        drones += type == UnitTypes::Zerg_Drone;
+        hatcheries += type == UnitTypes::Zerg_Hatchery || type == UnitTypes::Zerg_Lair || type == UnitTypes::Zerg_Hive;
+        spawningPools += type == UnitTypes::Zerg_Spawning_Pool;
+        zerglings += type == UnitTypes::Zerg_Zergling;
+    }
+    ofstream output("bwapi-data/write/diagnostic.json", ios::trunc);
+    output << "{\"frame_count\":" << Broodwar->getFrameCount()
+           << ",\"winner\":" << (ended ? (winner ? "true" : "false") : "null")
+           << ",\"ended\":" << (ended ? "true" : "false")
+           << ",\"latency_frames\":" << Broodwar->getLatencyFrames()
+           << ",\"bot_seed\":" << (evaluationSeedSet ? to_string(evaluationSeed) : "null")
+           << ",\"drones\":" << drones << ",\"hatcheries\":" << hatcheries
+           << ",\"spawning_pools\":" << spawningPools << ",\"zerglings\":" << zerglings << "}\n";
+}
+}
