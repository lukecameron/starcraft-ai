+                !BWAPI::Broodwar->self()->isEnemy(enemy->getPlayer())) continue;
+            const int distance = enemy->getDistance(home);
+            if (distance >= 12 * 32 || distance > nearest) continue;
+            if (!threat || distance < nearest || enemy->getID() < threat->getID()) {
+                nearest = distance;
+                threat = enemy;
+            }
+        }
