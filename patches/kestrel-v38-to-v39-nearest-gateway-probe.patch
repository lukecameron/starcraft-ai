+    BWAPI::Unit availableGatewayProbe(const BWAPI::TilePosition& tile) {
+        const BWAPI::Position target(tile.x * 32 + 16, tile.y * 32 + 16);
+        BWAPI::Unit best = nullptr;
+        int bestDistance = std::numeric_limits<int>::max();
+        int bestId = std::numeric_limits<int>::max();
+        for (auto unit : BWAPI::Broodwar->self()->getUnits()) {
+            if (!unit->exists() || !unit->isCompleted() || unit->getType() != BWAPI::UnitTypes::Protoss_Probe) continue;
+            if (unit->getID() == scoutId_) continue;
+            if (isEmergencyDefender(unit->getID())) {
+                ++emergencyBuildSelectionExclusions_;
+                continue;
+            }
+            if (unit->isGatheringGas()) {
+                recordGasWorkerGuard(unit, "gateway_probe");
+                continue;
+            }
+            if (unit->isConstructing()) continue;
+            const int distance = unit->getDistance(target);
+            if (distance < bestDistance || (distance == bestDistance && unit->getID() < bestId)) {
+                best = unit;
+                bestDistance = distance;
+                bestId = unit->getID();
+            }
+        }
+        return best;
+    }
