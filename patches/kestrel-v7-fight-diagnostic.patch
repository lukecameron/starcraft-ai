+    void logSnapshot() const {
+        auto self = BWAPI::Broodwar->self();
+        const BWAPI::TilePosition start = self->getStartLocation();
+        const BWAPI::Position home(start.x * 32 + 64, start.y * 32 + 48);
+        std::ofstream out(diagnosticPath(), std::ios::app);
+        out << "{\"event\":\"snapshot\",\"frame\":" << BWAPI::Broodwar->getFrameCount()
+            << ",\"minerals\":" << self->minerals() << ",\"gas\":" << self->gas()
+            << ",\"supply_used\":" << self->supplyUsed() << ",\"supply_total\":" << self->supplyTotal()
+            << ",\"zealots_all\":" << count(BWAPI::UnitTypes::Protoss_Zealot)
+            << ",\"zealots_completed\":" << count(BWAPI::UnitTypes::Protoss_Zealot, true)
+            << ",\"probes_all\":" << count(BWAPI::UnitTypes::Protoss_Probe)
+            << ",\"probes_completed\":" << count(BWAPI::UnitTypes::Protoss_Probe, true)
+            << ",\"own_units\":[";
+        bool first = true;
+        for (auto unit : sorted(self->getUnits())) {
+            const auto type = unit->getType();
+            if (!unit->exists() || (type != BWAPI::UnitTypes::Protoss_Probe && type != BWAPI::UnitTypes::Protoss_Zealot)) continue;
+            if (!first) out << ',';
+            first = false;
+            const auto position = unit->getPosition();
+            out << "{\"id\":" << unit->getID() << ",\"type\":\"" << type.getName()
+                << "\",\"x\":" << position.x << ",\"y\":" << position.y
+                << ",\"hp\":" << unit->getHitPoints() << ",\"completed\":" << (unit->isCompleted() ? "true" : "false")
+                << ",\"order\":\"" << unit->getOrder().getName() << "\"}";
+        }
+        out << "],\"nearby_visible_enemies\":[";
+        first = true;
+        for (auto unit : BWAPI::Broodwar->getAllUnits()) {
+            if (!unit->exists() || !unit->isVisible() || !unit->isDetected() || unit->isFlying() ||
+                !self->isEnemy(unit->getPlayer()) || unit->getDistance(home) >= 16 * 32) continue;
+            if (!first) out << ',';
+            first = false;
+            const auto position = unit->getPosition();
+            out << "{\"id\":" << unit->getID() << ",\"type\":\"" << unit->getType().getName()
+                << "\",\"x\":" << position.x << ",\"y\":" << position.y
+                << ",\"hp\":" << unit->getHitPoints() << "}";
+        }
+        out << "]}\n";
+        out.flush();
+    }
 
