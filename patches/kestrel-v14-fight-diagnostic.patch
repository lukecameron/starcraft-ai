+                << ",\"target_x\":" << tp.x << ",\"target_y\":" << tp.y
+                << ",\"ground_cooldown\":" << unit->getGroundWeaponCooldown() << '}';
+        }
+        out << "],\"visible_enemy_ground\":[";
+        first = true;
+        for (auto unit : BWAPI::Broodwar->getAllUnits()) {
+            if (!unit->exists() || !unit->isVisible() || !unit->isDetected() || unit->isFlying() || !self->isEnemy(unit->getPlayer())) continue;
