+                << ",\"shields\":" << unit->getShields() << ",\"order_id\":" << unit->getOrder().getID()
+                << ",\"ground_cooldown\":" << unit->getGroundWeaponCooldown()
+                << ",\"distance_home\":" << unit->getDistance(home) << '}';
+        }
+        out << "]}\n";
+    }
 
