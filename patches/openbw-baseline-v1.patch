 struct sync_state {
+	struct scenario_control_t {
+		bool enabled = false;
+		uint32_t seed = 0;
+		uint32_t player_id = 0;
+	};
+
+	static scenario_control_t scenario_control() {
+		const char* seed_str = std::getenv("OPENBW_SCENARIO_SEED");
+		const char* player_id_str = std::getenv("OPENBW_SCENARIO_PLAYER_ID");
+		if (!seed_str && !player_id_str) return {};
+		if (!seed_str || !player_id_str) error("OPENBW_SCENARIO_SEED and OPENBW_SCENARIO_PLAYER_ID must be set together");
+		auto parse_uint32 = [](const char* name, const char* value) {
+			if (!*value) error("%s must be a decimal uint32", name);
+			for (const char* p = value; *p; ++p) {
+				if (*p < '0' || *p > '9') error("%s must be a decimal uint32", name);
+			}
+			char* end = nullptr;
+			errno = 0;
+			unsigned long long parsed = std::strtoull(value, &end, 10);
+			if (errno || !end || *end || parsed > 0xffffffffull) error("%s must be a decimal uint32", name);
+			return (uint32_t)parsed;
+		};
+		scenario_control_t r;
+		r.enabled = true;
+		r.seed = parse_uint32("OPENBW_SCENARIO_SEED", seed_str);
+		r.player_id = parse_uint32("OPENBW_SCENARIO_PLAYER_ID", player_id_str);
+		if (!r.player_id) error("OPENBW_SCENARIO_PLAYER_ID must be nonzero");
+		return r;
+	}
+
