+    static bool isCombatUnit(BWAPI::Unit unit) {
+        return unit && (unit->getType() == BWAPI::UnitTypes::Protoss_Zealot ||
+                        unit->getType() == BWAPI::UnitTypes::Protoss_Dragoon);
+    }
+
+    bool isZergReserve(int id) const {
+        return std::find(zergReserveIds_.begin(), zergReserveIds_.end(), id) != zergReserveIds_.end();
+    }
+
+    bool removeZergReserve(int id) {
+        const auto found = std::find(zergReserveIds_.begin(), zergReserveIds_.end(), id);
+        if (found == zergReserveIds_.end()) return false;
+        zergReserveIds_.erase(found);
+        zergReserveLastThreatTargets_.erase(id);
+        zergReserveHomeMoveLastFrame_.erase(id);
+        attackRequests_.erase(id);
+        ++zergReserveDeathEvents_;
+        return true;
+    }
+
+    void refreshZergReserve(const BWAPI::Position& home, int frame) {
+        if (!knownZerg_) return;
+
+        for (auto it = zergReserveIds_.begin(); it != zergReserveIds_.end();) {
+            if (unitById(*it)) {
+                ++it;
+            } else {
+                const int deadId = *it;
+                it = zergReserveIds_.erase(it);
+                zergReserveLastThreatTargets_.erase(deadId);
+                zergReserveHomeMoveLastFrame_.erase(deadId);
+                attackRequests_.erase(deadId);
+                ++zergReserveDeathEvents_;
+            }
+        }
+
+        std::vector<BWAPI::Unit> candidates;
+        for (auto unit : BWAPI::Broodwar->self()->getUnits()) {
+            if (unit->exists() && unit->isCompleted() && isCombatUnit(unit)) candidates.push_back(unit);
+        }
+        std::sort(candidates.begin(), candidates.end(), [&home](BWAPI::Unit a, BWAPI::Unit b) {
+            const int aDistance = a->getDistance(home);
+            const int bDistance = b->getDistance(home);
+            if (aDistance != bDistance) return aDistance < bDistance;
+            return a->getID() < b->getID();
+        });
+        for (auto unit : candidates) {
+            if (zergReserveIds_.size() >= 3) break;
+            if (isZergReserve(unit->getID())) continue;
+            zergReserveIds_.push_back(unit->getID());
+            ++zergReserveRecruitEvents_;
+        }
+        zergReservePeak_ = std::max(zergReservePeak_, static_cast<int>(zergReserveIds_.size()));
+        if (zergReserveIds_.size() >= 3 && zergFirstReserveThreeFrame_ < 0)
+            zergFirstReserveThreeFrame_ = frame;
+        const int army = count(BWAPI::UnitTypes::Protoss_Zealot, true) + count(BWAPI::UnitTypes::Protoss_Dragoon, true);
+        zergReserveCurrentSurplus_ = std::max(0, army - static_cast<int>(zergReserveIds_.size()));
+        zergReserveMaxSurplus_ = std::max(zergReserveMaxSurplus_, zergReserveCurrentSurplus_);
     }
 
+    void issueZergReserveHomeMove(BWAPI::Unit unit, const BWAPI::Position& home, int frame) {
+        if (unit->getTargetPosition() == home) return;
+        if (unit->getDistance(home) <= 4 * 32 && !unit->isMoving()) return;
+        const auto previous = zergReserveHomeMoveLastFrame_.find(unit->getID());
+        const bool hadPrevious = previous != zergReserveHomeMoveLastFrame_.end();
+        if (hadPrevious && frame - previous->second < 96) {
+            ++zergReserveHomeMoveCooldownBlocks_;
+            return;
+        }
+        ++zergReserveHomeMoveAttempts_;
+        zergReserveHomeMoveLastFrame_[unit->getID()] = frame;
+        if (issue(unit->move(home), AttackCommand)) {
+            ++zergReserveHomeMoveOrders_;
+            const auto previousAccepted = zergReserveHomeMoveLastAcceptedFrame_.find(unit->getID());
+            const bool hadAcceptedPrevious = previousAccepted != zergReserveHomeMoveLastAcceptedFrame_.end();
+            if (hadAcceptedPrevious) {
+                const int interval = frame - previousAccepted->second;
+                if (zergReserveHomeMoveMinAcceptedRepeatInterval_ < 0 ||
+                    interval < zergReserveHomeMoveMinAcceptedRepeatInterval_)
+                    zergReserveHomeMoveMinAcceptedRepeatInterval_ = interval;
+            }
+            const int acceptedCount = ++zergReserveHomeMoveAcceptedCounts_[unit->getID()];
+            zergReserveHomeMoveMaxAcceptedPerUnit_ =
+                std::max(zergReserveHomeMoveMaxAcceptedPerUnit_, acceptedCount);
+            zergReserveHomeMoveLastAcceptedFrame_[unit->getID()] = frame;
+            if (hadAcceptedPrevious) {
+                ++zergReserveHomeMoveRepeatOrders_;
+                zergReserveHomeMoveRepeatUnits_[unit->getID()] = frame;
+            }
+        }
+    }
