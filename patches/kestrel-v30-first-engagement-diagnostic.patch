+
+    void writeAcceptedCommand(const char* command, BWAPI::Unit actor,
+                              BWAPI::UnitType produced, BWAPI::Position position) const {
+        std::ofstream out(diagnosticPath(), std::ios::app);
+        if (!out) return;
+        out << "{\"record\":\"event\",\"event\":\"accepted_command\",\"command\":\""
+            << command << "\",\"frame\":" << BWAPI::Broodwar->getFrameCount()
+            << ",\"actor_id\":" << (actor ? actor->getID() : -1)
+            << ",\"actor_type\":\"" << (actor ? actor->getType().getName() : "None")
+            << "\",\"produced_type\":\"" << produced.getName() << "\",\"position\":{";
+        writePosition(out, position);
+        out << "}}\n";
+        out.flush();
+    }
+
+    void writeAcceptedAttack(BWAPI::Unit actor, BWAPI::Unit target, bool targetChanged) const {
+        std::ofstream out(diagnosticPath(), std::ios::app);
+        if (!out) return;
+        const BWAPI::Position actorPosition = actor ? actor->getPosition() : BWAPI::Positions::None;
+        const BWAPI::Position targetPosition = target ? target->getPosition() : BWAPI::Positions::None;
+        const int distance = actor && target ? actor->getDistance(target) : -1;
+        out << "{\"record\":\"event\",\"event\":\"accepted_attack\",\"frame\":"
+            << BWAPI::Broodwar->getFrameCount()
+            << ",\"target_changed\":" << (targetChanged ? "true" : "false")
+            << ",\"actor_id\":" << (actor ? actor->getID() : -1)
+            << ",\"actor_type\":\"" << (actor ? actor->getType().getName() : "None")
+            << "\",\"actor_position\":{";
+        writePosition(out, actorPosition);
+        out << "},\"target_id\":" << (target ? target->getID() : -1)
+            << ",\"target_type\":\"" << (target ? target->getType().getName() : "None")
+            << "\",\"target_position\":{";
+        writePosition(out, targetPosition);
+        out << "},\"distance\":" << distance << "}\n";
+        out.flush();
+    }
